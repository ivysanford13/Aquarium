rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in account can only read/write the data under their own
    // users/{their uid}/... path. Nobody can see or touch another
    // account's tanks, even if they know the project's public config.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
